{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "server.ts",
    "tui.tsx",
    "src/**/*.ts"
  ]
}
